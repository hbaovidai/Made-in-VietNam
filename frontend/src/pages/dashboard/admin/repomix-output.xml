                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <div>
            <div className="wp-card">
              <div className="wp-card-header"><span className="wp-card-title">{t('req_rfq_progress_title')}</span></div>
              <div className="wp-card-body">
