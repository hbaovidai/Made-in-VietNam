                    type="button"
                    className="wp-add-new-tax-link"
                    onClick={() => setShowAddBrand(true)}
                  >
                    + Thêm thương hiệu mới
                  </button>
                ) : (
                  <form onSubmit={handleAddBrand} className="wp-add-new-tax-form">
                    <div style={{ marginBottom: 8 }}>
