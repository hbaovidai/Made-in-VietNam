                            <td>{r.category}</td>
                            <td>{r.quantity} {r.unit}</td>
                            <td><strong>{r.suppliers.length}</strong> {t('req_suppliers_business')}</td>
                            <td>
                              {t('req_progress_label')} <strong>{r.suppliers.filter(s => s.status === 'processed').length}/{r.suppliers.length}</strong>
