                  </thead>
                  <tbody>
                    {detailRfq.suppliers.map(s => (
                      <tr key={s.email}>
                        <td style={{ fontWeight: 600 }}>{s.name}</td>
                        <td>{s.email}</td>
                        <td>
                          <span className={`wp-badge ${s.status === 'processed' ? 'wp-badge-approved' : 'wp-badge-pending'}`}>
                            {s.status === 'processed' ? t('req_status_processed') : t('req_status_pending')}
