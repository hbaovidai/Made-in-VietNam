        <>
          <h1 className="wp-page-title">{t('req_customers_page_title')}</h1>
          <div className="wp-table-top">
            <div></div>
            <div className="wp-table-search">
              <input
                type="text"
                placeholder={t('req_search_customer_placeholder')}
