                <tr><th style={{ width: 90, fontSize: 12 }}>{t('req_detail_fullname')}</th><td>{selectedCustomerInfo.name}</td></tr>
                <tr><th style={{ fontSize: 12 }}>{t('req_detail_company')}</th><td>{selectedCustomerInfo.company}</td></tr>
