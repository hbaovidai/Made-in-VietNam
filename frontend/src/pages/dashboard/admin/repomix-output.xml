                  <span>{t('req_rfq_progress_label')}</span>
                  <span>{progressPercent}%</span>
                </div>
                <div style={{ height: 10, background: '#e0e0e0', borderRadius: 5, overflow: 'hidden', marginBottom: 12 }}>
