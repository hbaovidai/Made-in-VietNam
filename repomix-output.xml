            <img src="https://flagcdn.com/w40/vn.png" srcSet="https://flagcdn.com/w80/vn.png 2x" alt="Vietnam Flag" className="h-4 rounded-sm" />
            <span className="text-slate-400 font-medium">{t('proudly_vietnamese')}</span>
          </div>
        </div>
      </div>
    </footer>
  );
}
