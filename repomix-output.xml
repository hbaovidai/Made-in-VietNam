              <NavDropdown label={t('buyer')} to="/dashboard/buyer" className="h-full" panelClassName="left-auto right-0" arrowClassName="left-auto right-6">
                <MegaMenu sections={buyerMenuSections} columns={3} className="w-[720px]" />
