<file path="frontend/src/index.css">
@import "tailwindcss";

@theme {
  --color-primary: #003366;
  --color-primary-light: #004080;
  --color-primary-dark: #002244;
  --color-viet-gold: #FFCD00;
  --color-viet-gold-dark: #D4AF37;
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
}

/* ============================================================
   Base Styles
   ============================================================ */
@layer base {
  body {
    @apply bg-white text-slate-900 antialiased;
  }

  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }

  /* Better focus visible */
  *:focus-visible {
    @apply outline-2 outline-offset-2 outline-primary;
  }

  /* Selection color */
  ::selection {
    @apply bg-primary/20 text-primary;
  }

  /* Hide number input spinners (we use custom +/- buttons) */
  input[type="number"]::-webkit-outer-spin-button,
  input[type="number"]::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  input[type="number"] {
    -moz-appearance: textfield;
  }
}

/* ============================================================
   Component Styles — Button Hierarchy
   ============================================================ */
@layer components {
  /* Primary Button — Main CTA */
  .btn-primary {
    @apply bg-primary text-white px-6 py-2.5 rounded-lg font-bold text-sm
           hover:bg-primary-dark hover:shadow-lg hover:shadow-primary/25
           active:scale-[0.97] active:shadow-none
           focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2
           transition-all duration-200 ease-out
           disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:shadow-none disabled:active:scale-100;
  }

  /* Secondary Button — Outlined */
  .btn-secondary {
    @apply bg-white text-primary border-2 border-primary px-6 py-2.5 rounded-lg font-bold text-sm
           hover:bg-blue-50 hover:shadow-md hover:shadow-primary/10
           active:scale-[0.97] active:bg-blue-100
           focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2
           transition-all duration-200 ease-out
           disabled:opacity-50 disabled:cursor-not-allowed;
  }

  /* Danger Button — Destructive action */
  .btn-danger {
    @apply bg-red-600 text-white px-6 py-2.5 rounded-lg font-bold text-sm
           hover:bg-red-700 hover:shadow-lg hover:shadow-red-600/25
           active:scale-[0.97] active:shadow-none
           focus-visible:ring-2 focus-visible:ring-red-500/50 focus-visible:ring-offset-2
           transition-all duration-200 ease-out
           disabled:opacity-50 disabled:cursor-not-allowed;
  }

  /* Ghost Button — Subtle, no background */
  .btn-ghost {
    @apply bg-transparent text-slate-600 px-6 py-2.5 rounded-lg font-bold text-sm
           hover:bg-slate-100 hover:text-slate-900
           active:scale-[0.97] active:bg-slate-200
           focus-visible:ring-2 focus-visible:ring-slate-400/50 focus-visible:ring-offset-2
           transition-all duration-200 ease-out
           disabled:opacity-50 disabled:cursor-not-allowed;
  }

  /* Gold Button — Premium CTA */
  .btn-gold {
    @apply bg-viet-gold text-primary-dark px-6 py-2.5 rounded-lg font-bold text-sm
           hover:bg-yellow-400 hover:shadow-lg hover:shadow-yellow-500/25
           active:scale-[0.97] active:shadow-none
           focus-visible:ring-2 focus-visible:ring-yellow-400/50 focus-visible:ring-offset-2
           transition-all duration-200 ease-out
           disabled:opacity-50 disabled:cursor-not-allowed;
  }

  /* Icon Button — Square, minimal */
  .btn-icon {
    @apply p-2 rounded-lg text-slate-400
           hover:bg-slate-100 hover:text-slate-700
           active:scale-[0.90] active:bg-slate-200
           transition-all duration-150 ease-out;
  }

  .btn-icon-danger {
    @apply p-2 rounded-lg text-slate-400
           hover:bg-red-50 hover:text-red-600
           active:scale-[0.90] active:bg-red-100
           transition-all duration-150 ease-out;
  }

  /* ============================================================
     Card Component
     ============================================================ */
  .card {
    @apply bg-white border border-slate-200 rounded-xl
           transition-all duration-300 ease-out;
  }

  .card-hover {
    @apply bg-white border border-slate-200 rounded-xl
           transition-all duration-300 ease-out
           hover:shadow-xl hover:shadow-slate-200/50 hover:-translate-y-0.5
           hover:border-slate-300;
  }

  .card-interactive {
    @apply bg-white border border-slate-200 rounded-xl
           transition-all duration-300 ease-out
           hover:shadow-xl hover:shadow-slate-200/50 hover:-translate-y-0.5
           hover:border-slate-300
           cursor-pointer
           active:scale-[0.99] active:shadow-md;
  }

  /* ============================================================
     Form Input
     ============================================================ */
  .input {
    @apply w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg
           text-sm text-slate-900 placeholder:text-slate-400
           hover:border-slate-300
           focus:border-primary focus:ring-2 focus:ring-primary/10 focus:bg-white
           outline-none transition-all duration-200;
  }

  .input-error {
    @apply w-full px-4 py-2.5 bg-red-50/50 border border-red-300 rounded-lg
           text-sm text-slate-900 placeholder:text-slate-400
           focus:border-red-500 focus:ring-2 focus:ring-red-500/10 focus:bg-white
           outline-none transition-all duration-200;
  }

  .input-label {
    @apply text-sm font-bold text-slate-700 mb-1.5 block;
  }

  .input-helper {
    @apply text-xs text-slate-400 mt-1;
  }

  .input-error-text {
    @apply text-xs text-red-500 mt-1 font-medium;
  }

  /* ============================================================
     Table Styles
     ============================================================ */
  .table-header {
    @apply px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest
           bg-slate-50 border-b border-slate-100;
  }

  .table-row {
    @apply hover:bg-slate-50/80 transition-colors duration-150 border-b border-slate-50 last:border-b-0;
  }

  .table-row-selected {
    @apply bg-blue-50/50 border-l-2 border-l-primary;
  }

  .table-cell {
    @apply px-6 py-4 text-sm;
  }
}

/* ============================================================
   Custom Animations
   ============================================================ */
@keyframes toast-slide-in {
  from {
    opacity: 0;
    transform: translateX(100%) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@keyframes toast-slide-out {
  from {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
  to {
    opacity: 0;
    transform: translateX(100%) scale(0.95);
  }
}

@keyframes modal-backdrop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes modal-content-in {
  from {
    opacity: 0;
    transform: scale(0.95) translateY(10px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

@keyframes skeleton-pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}

@keyframes fade-in {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-toast-in {
  animation: toast-slide-in 0.35s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

.animate-toast-out {
  animation: toast-slide-out 0.3s ease-in forwards;
}

.animate-modal-backdrop {
  animation: modal-backdrop-in 0.2s ease-out forwards;
}

.animate-modal-content {
  animation: modal-content-in 0.3s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

.animate-skeleton {
  animation: skeleton-pulse 1.5s ease-in-out infinite;
}

.animate-fade-in {
  animation: fade-in 0.3s ease-out forwards;
}
</file>

