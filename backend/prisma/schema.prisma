generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String                    @id @default(uuid())
  email         String                    @unique
  passwordHash  String                    @map("password_hash")
  role          Role                      @default(BUYER)
  fullName      String                    @map("full_name")
  phone         String?
  avatar        String?
  status        UserStatus                @default(ACTIVE)
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  auditLogs     AuditLog[]
  cart          Cart?
  conversations ConversationParticipant[]
  sentMessages  Message[]                 @relation("MessageSender")
  notifications Notification[]
  buyerOrders   Order[]                   @relation("BuyerOrders")
  rfqs          RFQ[]
  savedProducts SavedProduct[]
  supplier      Supplier?
  subscriptions UserSubscription[]
  viewHistory   ViewHistory[]
  reviews       ProductReview[]

  @@map("users")
}

model Supplier {
  id              String   @unique @id @default(uuid())
  slug            String   @unique
  userId          String   @unique @map("user_id")

  // contact info
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")
  accountHolderName String? @map("account_holder_name")
  accountHolderRole SupplierAccountHolderRole? @map("account_holder_role")
  authorizationLetterUrl String[] @map("authorization_letter_url")

  // legal info
  companyName          String                      @map("company_name")
  taxCode              String?  @map("tax_code")
  businessType         BusinessType?                    @map("business_type")
  legalRepName String? @map("legal_rep_name")
  legalRepGovId String? @map("legal_rep_gov_id")

  businessLicenseUrl   String[]                     @map("business_license_url")
  legalRepGovIdUrl String[] @map("legal_rep_gov_id_url")

  // pics
  logo                 String?
  banner               String?

  // extra info
  description          String?
  employee_count       String?
  yearEstablished      Int?                        @map("year_established")
  website              String?
  salesChannels        Json?                       @map("sales_channels") // we don't use this, queue for deletion
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  status               SupplierStatus              @default(APPLICATION_PENDING)
  supplierType     SupplierType?  @map("supplier_type")
  isFake Boolean? @map("is_fake") @default(false)

  // Relations
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  products       Product[]
  certifications Certification[]
  industries     SupplierIndustry[]
  markets        SupplierMarket[]
  batches        Batch[]
  quotes         Quote[]
  orders         Order[]

  addresses SupplierAddressMap[]
  documents SupplierDocumentMediaMap[]
  categories SupplierCategoryMap[]
  channels SupplierChannelMap[]

  // optional manufacturer or exporter profiles
  manufacturerProfile ManufacturerProfile?
  exporterProfile ExporterProfile?

  @@index([id])
  @@index([slug])
  @@index([companyName])
  @@index([updatedAt])
  @@index([status])
  @@index([taxCode])
  @@map("suppliers")
}

model ManufacturerProfile {
  id String @default(uuid())
  supplierId String @unique

  factAddress String @map("fact_address")
  ownFactory Boolean @default(true) @map("own_factory")

  prodVol String @map("production_volume")
  prodVolUnit String @map("production_volume_unit")
  workerCount Int @map("worker_count")

  locationRegUrl String[] @map("location_reg_papers_url")
  realEstPermPapersUrl String[] @map("real_est_perm_papers_url")
  industrySpecificPapersUrl String[] @map("industry_specific_paperls_url")
  factMedUrl String[] @map("factory_media_url")
  extraCertsUrl String[] @map("extra_certs_url")
  envCertsUrl String[] @map("environmental_certs_url")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("manufacturer_profile")
}

model ExporterProfile {
  id String @id @default(uuid())
  supplierId String @unique

  yearsExp Int @map("years_exp") @default(0)
  hasOrgCert Boolean @map("has_org_cert") @default(false)
  isMainIndust Boolean @map("is_main_indust") @default(true)

  exporterPapersUrl String[] @map("exporter_paper_url")
  foreignContractsUrl String[] @map("foreign_contracts_url")
  internationalCertsUrl String[] @map("international_certs_url")

  markets ExporterMarketMap[]

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("exporter_profile")
}

model Certification {
  id          String    @id @default(uuid())
  supplierId  String    @map("supplier_id")
  name        String
  issuedBy    String?   @map("issued_by")
  issuedDate  DateTime? @map("issued_date")
  expiryDate  DateTime? @map("expiry_date")
  documentUrl String?   @map("document_url")
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

model SupplierIndustry {
  id         String   @id @default(uuid())
  supplierId String   @map("supplier_id")
  industry   String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, industry])
  @@map("supplier_industries")
}

// yes i know the thing below me exists, i don't want to explode prod
// so we'll have to make do with some duplications
model ExporterMarketMap {
  exporterId String @map("exporter_id")
  marketCode MarketCode @map("market_code")

  exporter ExporterProfile @relation(fields:[exporterId], references:[id], onDelete: Cascade, onUpdate: Cascade)

  @@id([exporterId, marketCode])
  @@map("exporter_market_map")
}

model SupplierMarket {
  id         String   @id @default(uuid())
  supplierId String   @map("supplier_id")
  market     String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, market])
  @@map("supplier_markets")
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  nameEn    String?    @map("name_en")
  slug      String     @unique
  parentId  String?    @map("parent_id")
  createdAt DateTime   @default(now()) @map("created_at")
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children  Category[] @relation("SubCategories")
  products  Product[]

  suppliers SupplierCategoryMap[]

  @@index([id])
  @@index([name])
  @@index([nameEn])
  @@map("categories")
}

model Product {
  id                 String         @id @default(uuid())
  supplierId         String         @map("supplier_id")
  name               String
  nameEn             String?        @map("name_en")
  slug               String         @unique
  description        String?
  descriptionEn      String?        @map("description_en")
  pricingMode        PricingMode    @default(STANDARD) @map("pricing_mode")
  minPrice           Float          @map("min_price")
  maxPrice           Float          @map("max_price")
  currency           String         @default("VND")
  unit               String
  moq                Int
  moqUnit            String         @map("moq_unit")
  categoryId         String         @map("category_id")
  images             String[]
  status             ProductStatus  @default(PENDING)
  rating             Float          @default(0)
  reviewCount        Int            @default(0) @map("review_count")
  viewCount          Int            @default(0) @map("view_count")
  rfqMinQuantity     Int?           @map("rfq_min_quantity")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  attributes         Json?
  brand              String?
  customizations     String[]
  exportMarkets      String?        @map("export_markets")
  leadTime           String?        @map("lead_time")
  origin             String?
  port               String?
  productionCapacity String?        @map("production_capacity")
  sku                String?
  specifications     Json?
  batches            Batch[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  priceTiers         PriceTier[]
  category           Category       @relation(fields: [categoryId], references: [id])
  supplier           Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  savedBy            SavedProduct[]
  viewedBy           ViewHistory[]
  reviews            ProductReview[]

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([supplierId, status])
  @@index([categoryId])
  @@index([name])
  @@index([minPrice])
  @@map("products")
}

model PriceTier {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  minQty    Int     @map("min_qty")
  maxQty    Int?    @map("max_qty")
  price     Float
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("price_tiers")
}

model RFQ {
  id           String    @id @default(uuid())
  buyerId      String    @map("buyer_id")
  productName  String    @map("product_name")
  category     String
  quantity     Int
  quantityUnit String    @map("quantity_unit")
  description  String
  budget       String?
  destination  String
  contactName  String?   @map("contact_name")
  contactEmail String?   @map("contact_email")
  contactPhone String?   @map("contact_phone")
  status       RFQStatus @default(OPEN)
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  quotes       Quote[]
  buyer        User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([buyerId, createdAt])
  @@map("rfqs")
}

model Quote {
  id         String      @id @default(uuid())
  rfqId      String      @map("rfq_id")
  supplierId String      @map("supplier_id")
  price      Float
  currency   String      @default("VND")
  leadTime   String      @map("lead_time")
  message    String?
  status     QuoteStatus @default(PENDING)
  createdAt  DateTime    @default(now()) @map("created_at")
  rfq        RFQ         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier   Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("quotes")
}

model Conversation {
  id            String                    @id @default(uuid())
  lastMessage   String?                   @map("last_message")
  lastMessageAt DateTime?                 @map("last_message_at")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  participants  ConversationParticipant[]
  messages      Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")
  unreadCount    Int          @default(0) @map("unread_count")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  content        String
  type           MessageType  @default(TEXT)
  attachments    String[]
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Batch {
  id              String      @id @default(uuid())
  supplierId      String      @map("supplier_id")
  productId       String      @map("product_id")
  batchNumber     String      @unique @map("batch_number")
  manufactureDate DateTime    @map("manufacture_date")
  expiryDate      DateTime    @map("expiry_date")
  quantity        Int
  status          BatchStatus @default(ACTIVE)
  qrGenerated     Boolean     @default(false) @map("qr_generated")
  createdAt       DateTime    @default(now()) @map("created_at")
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier        Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  qrCodes         QRCode[]

  @@map("batches")
}

model QRCode {
  id         String      @id @default(uuid())
  batchId    String      @map("batch_id")
  code       String      @unique
  secretHash String      @map("secret_hash")
  scanCount  Int         @default(0) @map("scan_count")
  maxScans   Int         @default(50) @map("max_scans")
  status     QRStatus    @default(ACTIVE)
  createdAt  DateTime    @default(now()) @map("created_at")
  batch      Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  scanEvents ScanEvent[]

  @@map("qr_codes")
}

model ScanEvent {
  id        String   @id @default(uuid())
  qrCodeId  String   @map("qr_code_id")
  ipHash    String   @map("ip_hash")
  userAgent String?  @map("user_agent")
  location  String?
  isValid   Boolean  @default(true) @map("is_valid")
  createdAt DateTime @default(now()) @map("created_at")
  qrCode    QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId, createdAt])
  @@map("scan_events")
}

model SavedProduct {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("saved_products")
}

model ViewHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@map("view_history")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model ContactSubmission {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_submissions")
}

model ProductReview {
  id               String    @id @default(uuid())
  productId        String    @map("product_id")
  userId           String?   @map("user_id")
  rating           Int       @default(5)
  content          String
  images           String[]  @default([])
  verifiedPurchase Boolean   @default(false) @map("verified_purchase")
  helpfulCount     Int       @default(0) @map("helpful_count")
  sellerReply      String?   @map("seller_reply")
  sellerRepliedAt  DateTime? @map("seller_replied_at")
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED
  authorName       String    @map("author_name")
  authorEmail      String    @map("author_email")
  createdAt        DateTime  @default(now()) @map("created_at")

  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("product_reviews")
}


model MembershipPlan {
  id            String             @id @default(uuid())
  name          String
  price         Float
  currency      String             @default("VND")
  billingCycle  String             @default("monthly")
  features      String[]
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  subscriptions UserSubscription[]

  @@map("membership_plans")
}

model UserSubscription {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  planId    String         @map("plan_id")
  status    String         @default("active")
  startDate DateTime       @default(now()) @map("start_date")
  endDate   DateTime       @map("end_date")
  plan      MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_subscriptions")
}

model Report {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  coverImage  String?  @map("cover_image")
  pdfUrl      String?  @map("pdf_url")
  price       Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("reports")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique @map("user_id")
  updatedAt DateTime   @updatedAt @map("updated_at")
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique @map("order_number")
  buyerId         String        @map("buyer_id")
  supplierId      String        @map("supplier_id")
  recipientName   String        @map("recipient_name")
  recipientPhone  String        @map("recipient_phone")
  shippingAddress String        @map("shipping_address")
  note            String?
  paymentMethod   PaymentMethod @default(COD) @map("payment_method")
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  subtotal        Float         @default(0)
  shippingFee     Float         @default(0) @map("shipping_fee")
  totalAmount     Float         @default(0) @map("total_amount")
  status          OrderStatus   @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  items           OrderItem[]
  buyer           User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  supplier        Supplier      @relation(fields: [supplierId], references: [id])

  @@index([buyerId, status])
  @@index([supplierId, status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String  @map("order_id")
  productId    String  @map("product_id")
  productName  String  @map("product_name")
  productImage String? @map("product_image")
  unitPrice    Float   @map("unit_price")
  quantity     Int
  totalPrice   Float   @map("total_price")
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  targetName String?  @map("target_name")
  details    String?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Faq {
  id         String   @id @default(cuid())
  questionVi String   @map("question_vi")
  answerVi   String   @map("answer_vi")
  questionEn String   @map("question_en")
  answerEn   String   @map("answer_en")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("faqs")
}

model LegalSection {
  id        String   @id @default(cuid())
  titleVi   String   @map("title_vi")
  titleEn   String   @map("title_en")
  slug      String
  contentVi String   @map("content_vi")
  contentEn String   @map("content_en")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  pageKey   String   @default("terms") @map("page_key")

  @@unique([pageKey, slug])
  @@map("legal_sections")
}

enum Role {
  BUYER
  SUPPLIER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum ProductStatus {
  DRAFT
  PENDING
  ACTIVE
  PAUSED
  REJECTED
}

enum PricingMode {
  STANDARD
  CONTACT
  TIERED
}

enum RFQStatus {
  OPEN
  QUOTED
  NEGOTIATING
  CLOSED
  EXPIRED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum BatchStatus {
  ACTIVE
  PENDING
  EXPIRED
}

enum QRStatus {
  ACTIVE
  COMPROMISED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum SupplierStatus {
  VERIFIED
  SUSPENDED
  APPLICATION_REJECTED
  APPLICATION_PENDING
}

enum SupplierAccountHolderRole {
  OWNER
  MANAGER
  LEGAL_REP
  EMPLOYEE
}

enum SupplierType {
  DISTRIBUTOR
  MANUFACTURER
  EXPORTER
  DIGITAL_GOODS
  MANU_EXPORT
}

enum BusinessType {
  PRIVATE
  LIMITED_LIABILITY
  JOINT_STOCK
}

enum SaleChannelType {
  INSTAGRAM
  FACEBOOK
  SHOPEE
  LAZADA
  TIKTOK_SHOP
  SHOPIFY
  ZALO
  CUSTOM_WEBSITE
}

enum SupplierMediaType {
  AUTHORIZATION_LETTER
  BUSINESS_LICENSE
  LEGAL_REP_GOV_ID
}

// --- mapping tables --- //
model SupplierCategoryMap {
  categorySlug String @map("category_slug")
  categoryLevel Int @default(1) @map("category_level")
  supplierSlug String @map("supplier_slug")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relation
  category Category @relation(fields: [categorySlug], references: [slug], onDelete: Cascade, onUpdate: Cascade)
  supplier Supplier @relation(fields: [supplierSlug], references: [slug], onDelete: Cascade, onUpdate: Cascade)

  @@id([categorySlug, supplierSlug])
  @@map("supplier_category_map")
}

model SupplierChannelMap {
  supplierId String @map("supplier_id")
  url String
  type SaleChannelType

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  // relation
  supplier Supplier @relation(fields: [supplierId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([supplierId, type])
  @@index([supplierId])
  @@map("supplier_channel_map")
}

model SupplierAddressMap {
  supplierSlug String @map("supplier_slug")
  address String
  isPrimary Boolean @map("is_primary") @default(false)
  updatedAt DateTime @map("updated_at") @default(now())

  supplier Supplier @relation(fields: [supplierSlug], references:[slug], onUpdate: Cascade, onDelete: Cascade)

  @@id([supplierSlug, address])
  @@map("supplier_address_map")
}

model SupplierDocumentMediaMap {
  supplierId String @map("supplier_id")
  url String @id
  type SupplierMediaType

  createdAt DateTime? @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([supplierId, type])
  @@map("supplier_document_media_map")
}

