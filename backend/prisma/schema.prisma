// VIEproduct B2B Platform - Database Schema
// NestJS + PostgreSQL + Prisma

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==================== ENUMS ====================

enum Role {
  BUYER
  SUPPLIER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum ProductStatus {
  DRAFT
  PENDING
  ACTIVE
  PAUSED
  REJECTED
}

enum RFQStatus {
  OPEN
  QUOTED
  NEGOTIATING
  CLOSED
  EXPIRED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum BatchStatus {
  ACTIVE
  PENDING
  EXPIRED
}

enum QRStatus {
  ACTIVE
  COMPROMISED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum SupplierStatus {
  VERIFIED
  SUSPENDED
  APPLICATION_REJECTED
  APPLICATION_PENDING
}

enum SupplierAccountHolderRole {
  OWNER
  MANAGER
  LEGAL_REP
  EMPLOYEE
}

enum SupplierType {
  DISTRIBUTOR
  MANUFACTURER
  EXPORTER
  MANU_EXPORT
  DIGITAL_GOODS
}

enum BusinessType {
  PRIVATE
  LIMITED_LIABILITY
  JOINT_STOCK
}

// ==================== USERS ====================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         Role       @default(BUYER)
  fullName     String     @map("full_name")
  phone        String?
  avatar       String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relations
  supplier      Supplier?
  rfqs          RFQ[]

  sentMessages  Message[]                  @relation("MessageSender")
  conversations ConversationParticipant[]
  savedProducts SavedProduct[]
  viewHistory   ViewHistory[]
  notifications Notification[]
  subscriptions UserSubscription[]
  cart          Cart?
  buyerOrders   Order[]                    @relation("BuyerOrders")
  auditLogs     AuditLog[]

  @@map("users")

  // hopefully faster login
  @@index([index])
}

// ==================== SUPPLIERS ====================

model Supplier {
  id              String   @unique @id @default(uuid())
  slug            String   @unique
  userId          String   @unique @map("user_id")

  // legal info
  companyName     String   @map("company_name")
  taxCode             String?  @map("tax_code") @unique
  legalRepName String? @map("legal_rep_name")
  legalRepGovId String? @map("legal_rep_gov_id")
  province String?
  ward String?
  streetAddress             String? @map("address")
  businessType BusinessType? @map("business_type")
  // url for legal info
  legalRepGovIdUrl String[] @map("legal_rep_gov_id_url")
  businessLicenseUrl String[] @map("business_license_url")

  // contact info
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")
  accountHolderName String? @map("account_holder_name")
  accountHolderRole SupplierAccountHolderRole @map("account_holder_role")

  // url for account holder
  authorizationLetterUrl String[] @map("authorization_letter_url")

  // additional info
  description     String?
  yearEstablished     Int?     @map("year_established")
  website     String?
  supplierType     SupplierType?  @map("supplier_type")
  status     SupplierStatus? @default(APPLICATION_PENDING)

  logo            String?
  banner          String?

  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  // Relations
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  products       Product[]
  certifications Certification[]
  industries     SupplierIndustry[]
  markets        SupplierMarket[]
  batches        Batch[]
  quotes         Quote[]
  orders         Order[]

  // Indexes for fast queries
  @@index([status])        // Admin verification filter
  @@index([companyName])               // Search by company name
  @@index([updatedAt])
  @@index([id])
  @@index([slug])
  @@index([taxCode])
  @@map("suppliers")
}

model Certification {
  id          String    @id @default(uuid())
  supplierId  String    @map("supplier_id")
  name        String
  issuedBy    String?   @map("issued_by")
  issuedDate  DateTime? @map("issued_date")
  expiryDate  DateTime? @map("expiry_date")
  documentUrl String?   @map("document_url")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

model SupplierIndustry {
  id         String @id @default(uuid())
  supplierId String @map("supplier_id")
  industry   String

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, industry])
  @@map("supplier_industries")
}

model SupplierMarket {
  id         String @id @default(uuid())
  supplierId String @map("supplier_id")
  market     String

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, market])
  @@map("supplier_markets")
}

// ==================== PRODUCTS ====================

model Category {
  id       String  @id @default(uuid())
  name     String  @unique
  nameEn   String? @map("name_en")
  slug     String  @unique
  parentId String? @map("parent_id")

  // Self-relation for nested categories
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("SubCategories")
  products Product[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([id])
  @@index([name])
  @@index([nameEn])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  supplierId  String        @map("supplier_id")
  name        String
  nameEn      String?       @map("name_en")
  slug        String        @unique
  description String?
  descriptionEn String?     @map("description_en")
  minPrice    Float         @map("min_price")
  maxPrice    Float         @map("max_price")
  currency    String        @default("VND")
  unit        String        // "kg", "cái", "bộ"
  moq         Int           // Minimum Order Quantity
  moqUnit     String        @map("moq_unit")
  categoryId  String        @map("category_id")
  images      String[]      // Array of image URLs
  status      ProductStatus @default(PENDING)
  rating      Float         @default(0)
  reviewCount Int           @default(0) @map("review_count")
  viewCount   Int           @default(0) @map("view_count")
  rfqMinQuantity Int?       @map("rfq_min_quantity") // Ngưỡng số lượng để chuyển sang báo giá
  origin         String?    // Xuất xứ (Việt Nam, China, etc.)
  leadTime       String?    @map("lead_time") // "15-30 ngày"
  brand          String?
  sku            String?
  productionCapacity String? @map("production_capacity") // "10,000 units/tháng"
  port           String?    // "Cảng Cát Lái, HCM"
  exportMarkets  String?    @map("export_markets")
  attributes     Json?      // { "Màu sắc": ["Đen", "Trắng"], "Kích thước": ["S", "M", "L"] }
  customizations String[]   // ["OEM Manufacturing", "ODM Service", "In logo riêng"]
  specifications Json?      // { "Chất liệu": "Inox", "Trọng lượng": "500g" }
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  supplier     Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id])
  batches      Batch[]

  savedBy      SavedProduct[]
  viewedBy     ViewHistory[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  // Indexes for fast queries
  @@index([status, createdAt])       // Product listing (filter active + sort by date)
  @@index([categoryId, status])      // Category page filter
  @@index([supplierId, status])      // Supplier's product page
  @@index([categoryId])                    // Search by product name
  @@index([name])                    // Search by product name
  @@index([minPrice])                // Sort by price
  @@map("products")
}

// ==================== RFQ (Request for Quotation) ====================

model RFQ {
  id           String    @id @default(uuid())
  buyerId      String    @map("buyer_id")
  productName  String    @map("product_name")
  category     String
  quantity     Int
  quantityUnit String    @map("quantity_unit")
  description  String
  budget       String?
  destination  String
  contactName  String?   @map("contact_name")
  contactEmail String?   @map("contact_email")
  contactPhone String?   @map("contact_phone")
  status       RFQStatus @default(OPEN)
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  buyer  User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  quotes Quote[]

  // Indexes for fast queries
  @@index([status, expiresAt])         // Open RFQs marketplace listing
  @@index([buyerId, createdAt])        // Buyer's RFQ history
  @@map("rfqs")
}

model Quote {
  id         String      @id @default(uuid())
  rfqId      String      @map("rfq_id")
  supplierId String      @map("supplier_id")
  price      Float
  currency   String      @default("VND")
  leadTime   String      @map("lead_time")
  message    String?
  status     QuoteStatus @default(PENDING)
  createdAt  DateTime    @default(now()) @map("created_at")

  // Relations
  rfq      RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("quotes")
}

// ==================== MESSAGING ====================

model Conversation {
  id            String    @id @default(uuid())
  lastMessage   String?   @map("last_message")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String @id @default(uuid())
  conversationId String @map("conversation_id")
  userId         String @map("user_id")
  unreadCount    Int    @default(0) @map("unread_count")

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  senderId       String      @map("sender_id")
  content        String
  type           MessageType @default(TEXT)
  attachments    String[]
  createdAt      DateTime    @default(now()) @map("created_at")

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ==================== ANTI-COUNTERFEIT ====================

model Batch {
  id              String      @id @default(uuid())
  supplierId      String      @map("supplier_id")
  productId       String      @map("product_id")
  batchNumber     String      @unique @map("batch_number")
  manufactureDate DateTime    @map("manufacture_date")
  expiryDate      DateTime    @map("expiry_date")
  quantity        Int
  status          BatchStatus @default(ACTIVE)
  qrGenerated     Boolean     @default(false) @map("qr_generated")
  createdAt       DateTime    @default(now()) @map("created_at")

  // Relations
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qrCodes  QRCode[]

  @@map("batches")
}

model QRCode {
  id         String   @id @default(uuid())
  batchId    String   @map("batch_id")
  code       String   @unique
  secretHash String   @map("secret_hash")
  scanCount  Int      @default(0) @map("scan_count")
  maxScans   Int      @default(50) @map("max_scans")
  status     QRStatus @default(ACTIVE)
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  batch      Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  scanEvents ScanEvent[]

  @@map("qr_codes")
}

model ScanEvent {
  id        String   @id @default(uuid())
  qrCodeId  String   @map("qr_code_id")
  ipHash    String   @map("ip_hash")
  userAgent String?  @map("user_agent")
  location  String?
  isValid   Boolean  @default(true) @map("is_valid")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId, createdAt])
  @@map("scan_events")
}



// ==================== SAVED PRODUCTS ====================

model SavedProduct {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])                    // User's saved products page
  @@map("saved_products")
}

// ==================== VIEW HISTORY ====================

model ViewHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])          // User's browsing history
  @@map("view_history")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ==================== CONTACT SUBMISSIONS ====================

model ContactSubmission {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_submissions")
}

// ==================== MEMBERSHIP ====================

model MembershipPlan {
  id           String             @id @default(uuid())
  name         String             // Basic, Gold, Platinum
  price        Float
  currency     String             @default("VND")
  billingCycle String             @default("monthly")
  features     String[]
  isActive     Boolean            @default(true) @map("is_active")
  createdAt    DateTime           @default(now()) @map("created_at")
  
  subscriptions UserSubscription[]

  @@map("membership_plans")
}

model UserSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  planId    String   @map("plan_id")
  status    String   @default("active") // active, cancelled
  startDate DateTime @default(now()) @map("start_date")
  endDate   DateTime @map("end_date")
  
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("user_subscriptions")
}

// ==================== REPORTS ====================

model Report {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  coverImage  String?  @map("cover_image")
  pdfUrl      String?  @map("pdf_url")
  price       Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("reports")
}

// ==================== CART ====================

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ==================== ORDERS ====================

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique @map("order_number")
  buyerId         String        @map("buyer_id")
  buyer           User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  supplierId      String        @map("supplier_id")
  supplier        Supplier      @relation(fields: [supplierId], references: [id])

  recipientName   String        @map("recipient_name")
  recipientPhone  String        @map("recipient_phone")
  shippingAddress String        @map("shipping_address")
  note            String?

  paymentMethod   PaymentMethod @default(COD) @map("payment_method")
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")

  subtotal        Float         @default(0)
  shippingFee     Float         @default(0) @map("shipping_fee")
  totalAmount     Float         @default(0) @map("total_amount")

  status          OrderStatus   @default(PENDING)

  items           OrderItem[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([buyerId, status])
  @@index([supplierId, status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String  @map("order_id")
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String  @map("product_id")
  product      Product @relation(fields: [productId], references: [id])
  productName  String  @map("product_name")
  productImage String? @map("product_image")
  unitPrice    Float   @map("unit_price")
  quantity     Int
  totalPrice   Float   @map("total_price")

  @@map("order_items")
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  action      String   // e.g. "VERIFY_SUPPLIER", "LOCK_USER", "DELETE_PRODUCT"
  targetType  String   @map("target_type") // e.g. "Supplier", "User", "Product"
  targetId    String?  @map("target_id")
  targetName  String?  @map("target_name")
  details     String?  // JSON string with extra info
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==================== SITE SETTINGS ====================

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ==================== FAQs ====================

model Faq {
  id          String   @id @default(cuid())
  questionVi  String   @map("question_vi")
  answerVi    String   @map("answer_vi")
  questionEn  String   @map("question_en")
  answerEn    String   @map("answer_en")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("faqs")
}

// ==================== LEGAL SECTIONS ====================

model LegalSection {
  id        String   @id @default(cuid())
  pageKey   String   @default("terms") @map("page_key")
  titleVi   String   @map("title_vi")
  titleEn   String   @map("title_en")
  slug      String
  contentVi String   @map("content_vi") @db.Text
  contentEn String   @map("content_en") @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([pageKey, slug])
  @@map("legal_sections")
}

